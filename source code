    def new_document(self, force=False):
        if not force and not self.check_unsaved_changes():
            return

        self.loading = True
        self.editor.clear()
        self.loading = False

        self.current_file = None
        self.modified = False
        self.document_header = ""
        self.document_footer = ""

        self.editor.document().setModified(False)
        self.update_title()
        self.update_word_count()

    # --------------------------------------------------------
    # OPEN
    # --------------------------------------------------------

    def open_document(self):
        if not self.check_unsaved_changes():
            return

        path, _ = QFileDialog.getOpenFileName(
            self,
            "Open Document",
            "",
            "Word Documents (*.docx);;Text Files (*.txt);;All Files (*)",
        )

        if path:
            self.open_file_path(path)

    def open_file_path(self, path):
        path = os.path.abspath(os.path.expanduser(str(path)))

        if not os.path.isfile(path):
            QMessageBox.warning(
                self,
                "File Not Found",
                f"The file does not exist:\n\n{path}",
            )
            return False

        try:
            extension = Path(path).suffix.lower()

            if extension == ".docx":
                self.load_docx(path)
            elif extension == ".txt":
                with open(path, "r", encoding="utf-8") as f:
                    self.loading = True
                    self.editor.setPlainText(f.read())
                    self.loading = False
            else:
                QMessageBox.warning(
                    self,
                    "Unsupported File",
                    "MyWord V2 supports .docx and .txt files.",
                )
                return False

            self.current_file = path
            self.modified = False
            self.editor.document().setModified(False)
            self.update_title()
            self.update_word_count()
            return True

        except Exception as e:
            self.loading = False
            QMessageBox.critical(
                self,
                "Open Error",
                f"Could not open the document:\n\n{e}",
            )
            return False

    # --------------------------------------------------------
    # DOCX LOAD
    # --------------------------------------------------------

    def load_docx(self, path):
        docx = Document(path)

        self.loading = True
        self.editor.clear()
        self.document_header = ""
        self.document_footer = ""

        cursor = self.editor.textCursor()

        # Headers / footers
        try:
            if docx.sections:
                section = docx.sections[0]
                self.document_header = "\n".join(
                    p.text for p in section.header.paragraphs
                ).strip()
                self.document_footer = "\n".join(
                    p.text for p in section.footer.paragraphs
                ).strip()
        except Exception:
            pass

        # Document body in XML order: paragraphs + tables.
        body = docx._element.body

        for child in body.iterchildren():
            tag = child.tag.split("}")[-1]

            if tag == "p":
                paragraph = next(
                    (p for p in docx.paragraphs if p._p is child),
                    None,
                )
                if paragraph is not None:
                    self._load_paragraph(paragraph, cursor)

            elif tag == "tbl":
                table = next(
                    (t for t in docx.tables if t._tbl is child),
                    None,
                )
                if table is not None:
                    self._load_table(table, cursor)

        self.loading = False
        self.editor.document().setModified(False)

    def _load_paragraph(self, paragraph, cursor):
        block_format = QTextBlockFormat()

        if paragraph.alignment == WD_ALIGN_PARAGRAPH.CENTER:
            alignment = Qt.AlignmentFlag.AlignCenter
        elif paragraph.alignment == WD_ALIGN_PARAGRAPH.RIGHT:
            alignment = Qt.AlignmentFlag.AlignRight
        elif paragraph.alignment == WD_ALIGN_PARAGRAPH.JUSTIFY:
            alignment = Qt.AlignmentFlag.AlignJustify
        else:
            alignment = Qt.AlignmentFlag.AlignLeft

        block_format.setAlignment(alignment)
        cursor.setBlockFormat(block_format)

        # Handle runs and embedded drawings/images.
        for child in paragraph._p.iterchildren():
            tag = child.tag.split("}")[-1]

            if tag == "r":
                run = None
                for candidate in paragraph.runs:
                    if candidate._r is child:
                        run = candidate
                        break

                if run is None:
                    continue

                # Image?
                drawing = child.find(qn("w:drawing"))
                pict = child.find(qn("w:pict"))

                if drawing is not None or pict is not None:
                    image = self._extract_run_image(run, paragraph.part)
                    if image is not None:
                        self._insert_loaded_image(cursor, image)
                    continue

                self._insert_run(cursor, run)

            elif tag == "hyperlink":
                self._insert_hyperlink_element(
                    paragraph,
                    child,
                    cursor,
                )

        # Paragraph break
        cursor.insertText("\n")

        # Page break in paragraph
        if "page" in paragraph.text.lower():
            pass

    def _insert_run(self, cursor, run):
        text = run.text or ""

        if not text:
            return

        fmt = QTextCharFormat()

        if run.bold:
            fmt.setFontWeight(QFont.Weight.Bold)
        if run.italic:
            fmt.setFontItalic(True)
        if run.underline:
            fmt.setFontUnderline(True)
        if run.font.strike:
            fmt.setFontStrikeOut(True)

        if run.font.name:
            fmt.setFontFamilies([run.font.name])

        if run.font.size:
            fmt.setFontPointSize(run.font.size.pt)

        rgb = rgb_from_run(run)
        if rgb and len(rgb) == 6:
            fmt.setForeground(QColor("#" + rgb))

        try:
            if run.font.highlight_color:
                # python-docx uses enum names; use a safe default.
                fmt.setBackground(QColor("#FFF59D"))
        except Exception:
            pass

        cursor.insertText(text, fmt)

    def _extract_run_image(self, run, part):
        try:
            blips = run._r.xpath(".//a:blip")
            if not blips:
                return None

            rid = blips[0].get(
                "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}embed"
            )
            if not rid:
                return None

            image_part = part.related_parts[rid]
            data = image_part.blob

            image = QImage()
            if image.loadFromData(data):
                return image

        except Exception:
            return None

        return None

    def _insert_loaded_image(self, cursor, image):
        resource_id = f"memory-image:{id(image)}"
        self.editor.document().addResource(
            QTextDocument.ResourceType.ImageResource,
            resource_id,
            image,
        )

        fmt = QTextImageFormat()
        fmt.setName(resource_id)

        max_width = 600
        if image.width() > max_width:
            scale = max_width / image.width()
            fmt.setWidth(max_width)
            fmt.setHeight(image.height() * scale)
        else:
            fmt.setWidth(image.width())
            fmt.setHeight(image.height())

        cursor.insertImage(fmt)

    def _insert_hyperlink_element(self, paragraph, element, cursor):
        text = "".join(
            t.text or ""
            for t in element.iter()
            if t.tag.split("}")[-1] == "t"
        )

        if not text:
            return

        rid = element.get(
            "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
        )

        url = ""
        if rid:
            try:
                url = paragraph.part.rels[rid].target_ref
            except Exception:
                pass

        fmt = QTextCharFormat()
        fmt.setForeground(QColor("#0563C1"))
        fmt.setFontUnderline(True)

        if url:
            fmt.setAnchor(True)
            fmt.setAnchorHref(url)

        cursor.insertText(text, fmt)

    def _load_table(self, table, cursor):
        rows = len(table.rows)
        cols = max((len(r.cells) for r in table.rows), default=1)

        if rows <= 0 or cols <= 0:
            return

        qt_table = cursor.insertTable(rows, cols)

        for r, row in enumerate(table.rows):
            for c, cell in enumerate(row.cells):
                cell_cursor = qt_table.cellAt(r, c).firstCursorPosition()
                cell_cursor.insertText(cell.text)

        cursor.movePosition(QTextCursor.MoveOperation.End)
        cursor.insertText("\n")

    # --------------------------------------------------------
    # SAVE
    # --------------------------------------------------------

    def save_document(self):
        if not self.current_file:
            return self.save_as()

        try:
            extension = Path(self.current_file).suffix.lower()

            if extension == ".docx":
                self.save_docx(self.current_file)
            elif extension == ".txt":
                with open(self.current_file, "w", encoding="utf-8") as f:
                    f.write(self.editor.toPlainText())
            else:
                return self.save_as()

            self.modified = False
            self.editor.document().setModified(False)
            self.update_title()

            self.statusBar().showMessage("Document saved.", 3000)
            return True

        except Exception as e:
            QMessageBox.critical(
                self,
                "Save Error",
                f"Could not save the document:\n\n{e}",
            )
            return False

    def save_as(self):
        path, selected_filter = QFileDialog.getSaveFileName(
            self,
            "Save Document",
            "",
            "Word Document (*.docx);;Text File (*.txt)",
        )

        if not path:
            return False

        if "Word" in selected_filter and not path.lower().endswith(".docx"):
            path += ".docx"
        elif "Text" in selected_filter and not path.lower().endswith(".txt"):
            path += ".txt"

        self.current_file = os.path.abspath(path)
        return self.save_document()

    # --------------------------------------------------------
    # DOCX SAVE
    # --------------------------------------------------------

    def save_docx(self, path):
        document = Document()

        # Remove default paragraph.
        if document.paragraphs:
            p = document.paragraphs[0]._element
            p.getparent().remove(p)

        # Header / footer
        try:
            section = document.sections[0]
            if self.document_header:
                hp = section.header.paragraphs[0]
                hp.text = self.document_header

            if self.document_footer:
                fp = section.footer.paragraphs[0]
                fp.text = self.document_footer
        except Exception:
            pass

        doc = self.editor.document()
        block = doc.begin()

        while block.isValid():
            paragraph = document.add_paragraph()

            alignment = block.blockFormat().alignment()

            if alignment & Qt.AlignmentFlag.AlignCenter:
                paragraph.alignment = WD_ALIGN_PARAGRAPH.CENTER
            elif alignment & Qt.AlignmentFlag.AlignRight:
                paragraph.alignment = WD_ALIGN_PARAGRAPH.RIGHT
            elif alignment & Qt.AlignmentFlag.AlignJustify:
                paragraph.alignment = WD_ALIGN_PARAGRAPH.JUSTIFY
            else:
                paragraph.alignment = WD_ALIGN_PARAGRAPH.LEFT

            iterator = block.begin()

            while not iterator.atEnd():
                fragment = iterator.fragment()

                if fragment.isValid():
                    text = fragment.text()
                    fmt = fragment.charFormat()

                    # Embedded image
                    if fmt.isImageFormat():
                        self._save_fragment_image(
                            document,
                            paragraph,
                            fmt.toImageFormat(),
                        )

                    elif text:
                        self._save_text_fragment(
                            paragraph,
                            text,
                            fmt,
                        )

                iterator += 1

            block = block.next()

        document.save(path)

    def _save_text_fragment(self, paragraph, text, fmt):
        url = fmt.anchorHref()

        if fmt.isAnchor() and url:
            add_hyperlink(paragraph, text, url)
            return

        run = paragraph.add_run(text)

        families = fmt.fontFamilies()
        if families:
            run.font.name = families[0]

        if fmt.fontPointSize() > 0:
            run.font.size = Pt(fmt.fontPointSize())

        run.bold = fmt.fontWeight() >= QFont.Weight.Bold
        run.italic = fmt.fontItalic()
        run.underline = fmt.fontUnderline()
        run.font.strike = fmt.fontStrikeOut()

        color = fmt.foreground().color()
        if color.isValid():
            run.font.color.rgb = RGBColor(
                color.red(),
                color.green(),
                color.blue(),
            )

    def _save_fragment_image(self, document, paragraph, image_format):
        name = image_format.name()
        image = self.editor.document().resource(
            QTextDocument.ResourceType.ImageResource,
            QUrl(name),
        )

        if image is None:
            image = self.editor.document().resource(
                QTextDocument.ResourceType.ImageResource,
                name,
            )

        if isinstance(image, QImage) and not image.isNull():
            temp_dir = Path(tempfile.gettempdir()) / "myword_images"
            temp_dir.mkdir(exist_ok=True)
            temp_file = temp_dir / f"{abs(hash(name))}.png"
            image.save(str(temp_file), "PNG")

            run = paragraph.add_run()
            run.add_picture(str(temp_file))

    # --------------------------------------------------------
    # FORMATTING
    # --------------------------------------------------------

    def merge_format(self, fmt):
        cursor = self.editor.textCursor()

        if cursor.hasSelection():
            cursor.mergeCharFormat(fmt)
        else:
            self.editor.mergeCurrentCharFormat(fmt)

    def toggle_bold(self):
        fmt = QTextCharFormat()
        current = self.editor.textCursor().charFormat().fontWeight()
        fmt.setFontWeight(
            QFont.Weight.Normal
            if current >= QFont.Weight.Bold
            else QFont.Weight.Bold
        )
        self.merge_format(fmt)

    def toggle_italic(self):
        fmt = QTextCharFormat()
        fmt.setFontItalic(
            not self.editor.textCursor().charFormat().fontItalic()
        )
        self.merge_format(fmt)

    def toggle_underline(self):
        fmt = QTextCharFormat()
        fmt.setFontUnderline(
            not self.editor.textCursor().charFormat().fontUnderline()
        )
        self.merge_format(fmt)

    def toggle_strike(self):
        fmt = QTextCharFormat()
        fmt.setFontStrikeOut(
            not self.editor.textCursor().charFormat().fontStrikeOut()
        )
        self.merge_format(fmt)

    def change_font(self, font):
        if font:
            fmt = QTextCharFormat()
            fmt.setFontFamilies([font])
            self.merge_format(fmt)

    def change_font_size(self, size):
        try:
            value = float(size)
        except ValueError:
            return

        if value <= 0:
            return

        fmt = QTextCharFormat()
        fmt.setFontPointSize(value)
        self.merge_format(fmt)

    def change_text_color(self):
        color = QColorDialog.getColor(self, "Text Color")
        if color.isValid():
            fmt = QTextCharFormat()
            fmt.setForeground(color)
            self.merge_format(fmt)

    def highlight_text(self):
        color = QColorDialog.getColor(self, "Highlight Color")
        if color.isValid():
            fmt = QTextCharFormat()
            fmt.setBackground(color)
            self.merge_format(fmt)

    def clear_formatting(self):
        cursor = self.editor.textCursor()
        if cursor.hasSelection():
            cursor.setCharFormat(QTextCharFormat())

    # --------------------------------------------------------
    # PARAGRAPHS
    # --------------------------------------------------------

    def set_alignment(self, alignment):
        cursor = self.editor.textCursor()
        fmt = QTextBlockFormat()
        fmt.setAlignment(alignment)
        cursor.mergeBlockFormat(fmt)
        self.editor.setTextCursor(cursor)

    def toggle_bullets(self):
        self.editor.textCursor().createList(
            QTextListFormat.Style.ListDisc
        )

    def toggle_numbering(self):
        self.editor.textCursor().createList(
            QTextListFormat.Style.ListDecimal
        )

    # --------------------------------------------------------
    # IMAGE
    # --------------------------------------------------------

    def insert_image(self):
        path, _ = QFileDialog.getOpenFileName(
            self,
            "Insert Image",
            "",
            "Images (*.png *.jpg *.jpeg *.bmp *.gif *.webp *.svg)",
        )

        if not path:
            return

        image = QImage(path)

        if image.isNull():
            QMessageBox.warning(
                self,
                "Image Error",
                "Could not load this image.",
            )
            return

        self._insert_loaded_image(
            self.editor.textCursor(),
            image,
        )

    # --------------------------------------------------------
    # TABLE
    # --------------------------------------------------------

    def insert_table(self):
        rows, ok = QInputDialog.getInt(
            self, "Insert Table", "Rows:", 3, 1, 100
        )
        if not ok:
            return

        columns, ok = QInputDialog.getInt(
            self, "Insert Table", "Columns:", 3, 1, 30
        )
        if not ok:
            return

        self.editor.textCursor().insertTable(rows, columns)

    # --------------------------------------------------------
    # HYPERLINK
    # --------------------------------------------------------

    def insert_link(self):
        cursor = self.editor.textCursor()

        if cursor.hasSelection():
            text = cursor.selectedText()
        else:
            text, ok = QInputDialog.getText(
                self,
                "Insert Link",
                "Link text:",
            )
            if not ok or not text:
                return
            cursor.insertText(text)
            cursor.movePosition(
                QTextCursor.MoveOperation.Left,
                QTextCursor.MoveMode.KeepAnchor,
                len(text),
            )

        url, ok = QInputDialog.getText(
            self,
            "Insert Link",
            "URL:",
            text="https://",
        )

        if not ok or not url:
            return

        fmt = QTextCharFormat()
        fmt.setAnchor(True)
        fmt.setAnchorHref(url)
        fmt.setForeground(QColor("#0563C1"))
        fmt.setFontUnderline(True)
        cursor.mergeCharFormat(fmt)

    # --------------------------------------------------------
    # PAGE BREAK
    # --------------------------------------------------------

    def insert_page_break(self):
        cursor = self.editor.textCursor()
        cursor.insertText("\n")
        cursor.insertBlock()
        cursor.insertText("\f")

    # --------------------------------------------------------
    # HEADER / FOOTER
    # --------------------------------------------------------

    def set_header(self):
        text, ok = QInputDialog.getMultiLineText(
            self,
            "Document Header",
            "Header text:",
            self.document_header,
        )

        if ok:
            self.document_header = text
            self.modified = True
            self.update_title()

    def set_footer(self):
        text, ok = QInputDialog.getMultiLineText(
            self,
            "Document Footer",
            "Footer text:",
            self.document_footer,
        )

        if ok:
            self.document_footer = text
            self.modified = True
            self.update_title()

    # --------------------------------------------------------
    # FIND
    # --------------------------------------------------------

    def show_find_replace(self):
        FindReplaceDialog(self.editor, self).exec()

    # --------------------------------------------------------
    # STATE
    # --------------------------------------------------------

    def document_changed(self):
        if self.loading:
            return

        self.modified = True
        self.update_title()
        self.update_word_count()

    def update_title(self):
        filename = (
            os.path.basename(self.current_file)
            if self.current_file
            else "Untitled"
        )
        marker = "* " if self.modified else ""
        self.setWindowTitle(f"{marker}{filename} - {APP_NAME}")

    def update_word_count(self):
        text = self.editor.toPlainText()

        words = re.findall(
            r"\b[\w'-]+\b",
            text,
            flags=re.UNICODE,
        )

        self.word_label.setText(f"Words: {len(words)}")
        self.char_label.setText(f"Characters: {len(text)}")

        # QTextDocument does not expose true Word-style pages here.
        # Estimate based on printable text until the page-layout engine
        # is introduced.
        pages = max(1, (len(text) // 2200) + 1)
        self.page_label.setText(f"Pages: {pages}")

    def update_toolbar(self):
        cursor = self.editor.textCursor()
        fmt = cursor.charFormat()

        self.bold_action.blockSignals(True)
        self.bold_action.setChecked(
            fmt.fontWeight() >= QFont.Weight.Bold
        )
        self.bold_action.blockSignals(False)

        self.italic_action.blockSignals(True)
        self.italic_action.setChecked(fmt.fontItalic())
        self.italic_action.blockSignals(False)

        self.underline_action.blockSignals(True)
        self.underline_action.setChecked(fmt.fontUnderline())
        self.underline_action.blockSignals(False)

        self.strike_action.blockSignals(True)
        self.strike_action.setChecked(fmt.fontStrikeOut())
        self.strike_action.blockSignals(False)

        families = fmt.fontFamilies()
        if families:
            self.font_combo.blockSignals(True)
            self.font_combo.setCurrentText(families[0])
            self.font_combo.blockSignals(False)

        size = fmt.fontPointSize()
        if size > 0:
            self.size_combo.blockSignals(True)
            self.size_combo.setCurrentText(str(int(size)))
            self.size_combo.blockSignals(False)

    # --------------------------------------------------------
    # UNSAVED CHANGES
    # --------------------------------------------------------

    def check_unsaved_changes(self):
        if not self.modified:
            return True

        result = QMessageBox.question(
            self,
            "Unsaved Changes",
            "This document has unsaved changes.\n\n"
            "Do you want to save them?",
            QMessageBox.StandardButton.Save
            | QMessageBox.StandardButton.Discard
            | QMessageBox.StandardButton.Cancel,
        )

        if result == QMessageBox.StandardButton.Save:
            return self.save_document()

        if result == QMessageBox.StandardButton.Cancel:
            return False

        return True

    # --------------------------------------------------------
    # ABOUT
    # --------------------------------------------------------

    def show_about(self):
        QMessageBox.about(
            self,
            "About MyWord",
            f"""
            <h2>{APP_NAME}</h2>
            <p><b>Version {VERSION}</b></p>
            <p>A lightweight Word-compatible document editor.</p>
            <p>Built with Python, PySide6 and python-docx.</p>
            """,
        )

    # --------------------------------------------------------
    # CLOSE
    # --------------------------------------------------------

    def closeEvent(self, event):
        if self.check_unsaved_changes():
            event.accept()
        else:
            event.ignore()


# ============================================================
# MAIN
# ============================================================

def main():
    app = QApplication(sys.argv)
    app.setApplicationName(APP_NAME)
    app.setOrganizationName(APP_NAME)

    window = MyWord()

    # Windows / command-line file opening:
    # MyWord.exe "C:\Documents\example.docx"
    if len(sys.argv) > 1:
        file_path = sys.argv[1].strip('"')
        if os.path.isfile(file_path):
            window.open_file_path(file_path)

    window.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
