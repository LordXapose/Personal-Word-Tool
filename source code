class FindReplaceDialog(QDialog):
    def __init__(self, editor, parent=None):
        super().__init__(parent)
        self.editor = editor
        self.setWindowTitle("Find & Replace")
        self.setMinimumWidth(560)

        layout = QVBoxLayout(self)

        row1 = QHBoxLayout()
        row1.addWidget(QLabel("Find:"))
        self.find_input = QLineEdit()
        self.find_input.setPlaceholderText("Text to find...")
        row1.addWidget(self.find_input)
        layout.addLayout(row1)

        row2 = QHBoxLayout()
        row2.addWidget(QLabel("Replace:"))
        self.replace_input = QLineEdit()
        self.replace_input.setPlaceholderText("Replacement...")
        row2.addWidget(self.replace_input)
        layout.addLayout(row2)

        buttons = QHBoxLayout()
        for text, slot in (
            ("Find Next", self.find_next),
            ("Replace", self.replace_one),
            ("Replace All", self.replace_all),
            ("Close", self.close),
        ):
            b = QPushButton(text)
            b.clicked.connect(slot)
            buttons.addWidget(b)
        layout.addLayout(buttons)

        self.find_input.returnPressed.connect(self.find_next)

    def find_next(self):
        text = self.find_input.text()
        if not text:
            return

        if not self.editor.find(text):
            cursor = self.editor.textCursor()
            cursor.movePosition(QTextCursor.MoveOperation.Start)
            self.editor.setTextCursor(cursor)
            if not self.editor.find(text):
                QMessageBox.information(
                    self, "Find", f'Could not find "{text}".'
                )

    def replace_one(self):
        find_text = self.find_input.text()
        replace_text = self.replace_input.text()
        if not find_text:
            return

        cursor = self.editor.textCursor()
        if cursor.hasSelection() and cursor.selectedText() == find_text:
            cursor.insertText(replace_text)
        else:
            self.find_next()

    def replace_all(self):
        find_text = self.find_input.text()
        replace_text = self.replace_input.text()
        if not find_text:
            return

        document = self.editor.document()
        cursor = QTextCursor(document)
        count = 0

        cursor.beginEditBlock()
        while True:
            cursor = document.find(find_text, cursor)
            if cursor.isNull():
                break
            cursor.insertText(replace_text)
            count += 1
        cursor.endEditBlock()

        QMessageBox.information(
            self,
            "Replace All",
            f"Replaced {count} occurrence(s)."
            if count
            else f'Could not find "{find_text}".',
        )


